{
  "name": "tourism-cockpit-h5",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "build:gh": "cross-env GITHUB_PAGES=true npm run build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:add": "cap add android",
    "android:build:debug": "cd android && gradlew assembleDebug",
    "android:build:release": "cd android && gradlew assembleRelease",
    "deploy:api": "node scripts/deploy-github-api.mjs"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "framer-motion": "^11.3.21",
    "howler": "^2.2.4",
    "lucide-react": "^0.439.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "uuid": "^14.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@octokit/rest": "^21.0.0",
    "@types/howler": "^2.2.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.41",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
