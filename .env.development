# SDK 模式：mock | real
VITE_BAIDU_SDK_MODE=mock
VITE_TENCENT_SDK_MODE=mock
VITE_WECHAT_MODE=mock

# 百度数字人 SDK（生产环境填入真实凭证）
VITE_BAIDU_APP_ID=your_baidu_app_id
VITE_BAIDU_API_KEY=your_baidu_api_key
VITE_BAIDU_SECRET_KEY=your_baidu_secret_key

# 腾讯云短视频 SDK
VITE_TENCENT_SECRET_ID=your_tencent_secret_id
VITE_TENCENT_SECRET_KEY=your_tencent_secret_key

# 微信 JSSDK
VITE_WECHAT_APP_ID=your_wechat_app_id
